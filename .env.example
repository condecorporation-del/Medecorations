# URL pública del despliegue (incluye https://)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Teléfono de WhatsApp Business en formato internacional solo dígitos; ejemplo 526241234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase → Project Settings → API. Mantener la service role key solo en el servidor.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys y dominio remitente verificado
RESEND_API_KEY=
EMAIL_FROM=ME Cabo <reservas@tudominio.com>
ADMIN_EMAIL=equipo@tudominio.com

# Stripe → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
